# Server Port (Render will automatically inject PORT, default locally is 11100)
PORT=11100

# Email / SMTP Configuration (Gmail App Password or Mailtrap)
MAILTRAP_USER=your_gmail@gmail.com
MAILTRAP_PASS=your_app_password

# Supabase Database Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_service_or_anon_key
