# Server Port (Render will automatically inject PORT, default locally is 11100)
PORT=11100

# Email / SMTP Configuration (Gmail App Password or Mailtrap)
MAILTRAP_USER=your_gmail@gmail.com
MAILTRAP_PASS=your_app_password

# Supabase Database Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_service_role_key

# Required in production: generate using node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_at_least_32_random_characters
# Persistent volume path; run only one server instance.
MATCH_STATE_FILE=./data/matches.json
MATCH_SECONDS=600
